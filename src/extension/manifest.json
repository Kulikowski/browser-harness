{
  "manifest_version": 3,
  "name": "Browser Harness",
  "version": "0.1.0",
  "description": "Chat with the coding agent already on your machine. It uses the page's WebMCP tools, or the page itself. No API keys.",
  "minimum_chrome_version": "140",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Browser Harness",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "nativeMessaging", "storage", "unlimitedStorage", "tabs", "scripting", "debugger"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Open the chat"
    }
  }
}
